# PostgreSQL (Production / Neon / Supabase)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gan_db?schema=public"

# Public Site URL — canonical base for metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="https://ganb2b.org.np"

# NextAuth
