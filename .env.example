# Database Connection
# SQLite (Default local development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production / Neon / Supabase)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gan_db?schema=public"

# Public Site URL — canonical base for metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="https://ganb2b.org.np"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="trade-desk@ganepal.org"
GAN_ARCHIVE_EMAIL="leads@ganepal.org"

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Upstash Redis — Distributed rate limiting (REQUIRED in production)
# Sign up free at https://upstash.com > Create Database > REST API
# Without these, the in-memory fallback is used — NOT safe for serverless/multi-instance prod.
UPSTASH_REDIS_REST_URL="https://your-db-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Cloudflare Turnstile — CAPTCHA protection for RFQ and factory application forms
# Create a Turnstile widget at: https://dash.cloudflare.com/ > Turnstile > Add Site
# IMPORTANT: NEXT_PUBLIC_ prefix is intentional for the site key (browser widget).
# TURNSTILE_SECRET_KEY must NEVER be prefixed with NEXT_PUBLIC_ — server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."
